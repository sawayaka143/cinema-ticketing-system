# Copy to backend/.env and fill in DEV values only (ask the owner). Never commit .env.
# Supabase dev project -> Connect -> Transaction pooler (port 6543); use the postgresql+psycopg:// prefix.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
APP_ENV=development
# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGINS=http://localhost:5173

# Only for `python -m app.seed_users` (test logins on the DEV project). Leave empty in production.
# Dashboard -> Project Settings -> API keys -> service_role. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
# One shared password for customer@ / cashier@ / manager@ / admin@alatau.test
SEED_USER_PASSWORD=
