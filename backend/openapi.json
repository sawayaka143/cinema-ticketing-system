  "info": {
    "title": "Cinema Ticketing API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Liveness check used after every deploy.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/me": {
      "get": {
        "description": "The logged-in Supabase user. Proves auth works end to end.",
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "system"
        ]
      }
    },
    "/api/movies": {
      "get": {
        "description": "Active movies, by title.",
        "operationId": "list_movies_api_movies_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MovieOut"
                  },
                  "title": "Response List Movies Api Movies Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Movies",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/movies/{movie_id}": {
      "get": {
        "description": "One active movie. Unknown or archived ids are 404.",
        "operationId": "get_movie_api_movies__movie_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "movie_id",
            "required": true,
            "schema": {
              "title": "Movie Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Movie",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/movies/{movie_id}/screenings": {
      "get": {
        "description": "Upcoming screenings of one movie, earliest first. Past screenings are never listed.",
        "operationId": "list_movie_screenings_api_movies__movie_id__screenings_get",
        "parameters": [
          {
            "in": "path",
            "name": "movie_id",
            "required": true,
            "schema": {
              "title": "Movie Id",
              "type": "integer"
            }
          },
          {
            "description": "Day in Almaty time (YYYY-MM-DD). Omit for the next 7 days.",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Day in Almaty time (YYYY-MM-DD). Omit for the next 7 days.",
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScreeningOut"
                  },
                  "title": "Response List Movie Screenings Api Movies  Movie Id  Screenings Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Movie Screenings",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/screenings/{screening_id}": {
      "get": {
        "description": "One screening with its movie and hall.",
        "operationId": "get_screening_api_screenings__screening_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "screening_id",
            "required": true,
            "schema": {
              "title": "Screening Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScreeningDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Screening",
        "tags": [
          "catalog"
        ]
      }
    }
  }
}
