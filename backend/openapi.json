{
  "components": {
    "schemas": {
      "BookingOut": {
        "properties": {
          "booking_id": {
            "title": "Booking Id",
            "type": "integer"
          },
          "booking_time": {
            "format": "date-time",
            "title": "Booking Time",
            "type": "string"
          },
          "checked_in_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked In At"
          },
          "hold_expires_at": {
            "format": "date-time",
            "title": "Hold Expires At",
            "type": "string"
          },
          "qr_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set once paid: one QR code for all seats. Image: GET .../qr.png",
            "title": "Qr Token"
          },
          "seconds_left": {
            "description": "Seconds until the hold ends. 0 unless the booking is pending.",
            "title": "Seconds Left",
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending",
              "paid",
              "cancelled",
              "expired"
            ],
            "title": "Status",
            "type": "string"
          },
          "tickets": {
            "items": {
              "$ref": "#/components/schemas/BookingTicketOut"
            },
            "title": "Tickets",
            "type": "array"
          },
          "total_amount": {
            "title": "Total Amount",
            "type": "string"
          }
        },
        "required": [
          "booking_id",
          "status",
          "booking_time",
          "hold_expires_at",
          "seconds_left",
          "total_amount",
          "tickets",
          "qr_token",
          "checked_in_at"
        ],
        "title": "BookingOut",
        "type": "object"
      },
      "BookingTicketOut": {
        "properties": {
          "price": {
            "title": "Price",
            "type": "string"
          },
          "row_label": {
            "title": "Row Label",
            "type": "string"
          },
          "screening_id": {
            "title": "Screening Id",
            "type": "integer"
          },
          "seat_id": {
            "title": "Seat Id",
            "type": "integer"
          },
          "seat_number": {
            "title": "Seat Number",
            "type": "integer"
          },
          "ticket_id": {
            "title": "Ticket Id",
            "type": "integer"
          }
        },
        "required": [
          "ticket_id",
          "screening_id",
          "seat_id",
          "row_label",
          "seat_number",
          "price"
        ],
        "title": "BookingTicketOut",
        "type": "object"
      },
      "CheckinIn": {
        "properties": {
          "token": {
            "description": "The text in the QR code",
            "maxLength": 200,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "CheckinIn",
        "type": "object"
      },
      "CheckinOut": {
        "properties": {
          "booking_id": {
            "title": "Booking Id",
            "type": "integer"
          },
          "checked_in_at": {
            "format": "date-time",
            "title": "Checked In At",
            "type": "string"
          },
          "hall": {
            "title": "Hall",
            "type": "string"
          },
          "movie_title": {
            "title": "Movie Title",
            "type": "string"
          },
          "people": {
            "title": "People",
            "type": "integer"
          },
          "seats": {
            "examples": [
              [
                "A5",
                "A6"
              ]
            ],
            "items": {
              "type": "string"
            },
            "title": "Seats",
            "type": "array"
          },
          "start_time": {
            "format": "date-time",
            "title": "Start Time",
            "type": "string"
          }
        },
        "required": [
          "booking_id",
          "movie_title",
          "hall",
          "start_time",
          "seats",
          "people",
          "checked_in_at"
        ],
        "title": "CheckinOut",
        "type": "object"
      },
      "CustomerCreate": {
        "properties": {
          "full_name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "pattern": "^\\+7[0-9]{10}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "+77011234567"
            ],
            "title": "Phone"
          }
        },
        "required": [
          "full_name"
        ],
        "title": "CustomerCreate",
        "type": "object"
      },
      "CustomerOut": {
        "properties": {
          "customer_id": {
            "title": "Customer Id",
            "type": "integer"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "required": [
          "customer_id",
          "full_name",
          "email",
          "phone"
        ],
        "title": "CustomerOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HallOut": {
        "properties": {
          "hall_id": {
            "title": "Hall Id",
            "type": "integer"
          },
          "hall_type": {
            "title": "Hall Type",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "hall_id",
          "name",
          "hall_type"
        ],
        "title": "HallOut",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "HoldIn": {
        "properties": {
          "screening_id": {
            "title": "Screening Id",
            "type": "integer"
          },
          "seat_ids": {
            "description": "1 to 10 distinct seats of the screening's hall",
            "items": {
              "type": "integer"
            },
            "title": "Seat Ids",
            "type": "array"
          }
        },
        "required": [
          "screening_id",
          "seat_ids"
        ],
        "title": "HoldIn",
        "type": "object"
      },
      "Me": {
        "properties": {
          "customer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CustomerOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "staff": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StaffOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the user isn't staff or is deactivated."
          }
        },
        "required": [
          "id",
          "email",
          "customer",
          "staff"
        ],
        "title": "Me",
        "type": "object"
      },
      "MovieOut": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "duration_min": {
            "title": "Duration Min",
            "type": "integer"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "title": "Genres",
            "type": "array"
          },
          "min_age": {
            "title": "Min Age",
            "type": "integer"
          },
          "movie_id": {
            "title": "Movie Id",
            "type": "integer"
          },
          "poster_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poster Url"
          },
          "release_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Year"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "movie_id",
          "title",
          "description",
          "poster_url",
          "duration_min",
          "min_age",
          "release_year",
          "genres"
        ],
        "title": "MovieOut",
        "type": "object"
      },
      "PayIn": {
        "properties": {
          "method": {
            "enum": [
              "card",
              "kaspi"
            ],
            "title": "Method",
            "type": "string"
          },
          "simulate_decline": {
            "default": false,
            "description": "Fake provider: true makes this attempt fail (for demos/tests).",
            "title": "Simulate Decline",
            "type": "boolean"
          }
        },
        "required": [
          "method"
        ],
        "title": "PayIn",
        "type": "object"
      },
      "ScreeningDetail": {
        "properties": {
          "base_price": {
            "title": "Base Price",
            "type": "string"
          },
          "end_time": {
            "format": "date-time",
            "title": "End Time",
            "type": "string"
          },
          "hall": {
            "$ref": "#/components/schemas/HallOut"
          },
          "movie": {
            "$ref": "#/components/schemas/MovieOut"
          },
          "movie_id": {
            "title": "Movie Id",
            "type": "integer"
          },
          "screening_id": {
            "title": "Screening Id",
            "type": "integer"
          },
          "start_time": {
            "format": "date-time",
            "title": "Start Time",
            "type": "string"
          }
        },
        "required": [
          "screening_id",
          "movie_id",
          "hall",
          "start_time",
          "end_time",
          "base_price",
          "movie"
        ],
        "title": "ScreeningDetail",
        "type": "object"
      },
      "ScreeningOut": {
        "properties": {
          "base_price": {
            "title": "Base Price",
            "type": "string"
          },
          "end_time": {
            "format": "date-time",
            "title": "End Time",
            "type": "string"
          },
          "hall": {
            "$ref": "#/components/schemas/HallOut"
          },
          "movie_id": {
            "title": "Movie Id",
            "type": "integer"
          },
          "screening_id": {
            "title": "Screening Id",
            "type": "integer"
          },
          "start_time": {
            "format": "date-time",
            "title": "Start Time",
            "type": "string"
          }
        },
        "required": [
          "screening_id",
          "movie_id",
          "hall",
          "start_time",
          "end_time",
          "base_price"
        ],
        "title": "ScreeningOut",
        "type": "object"
      },
      "SeatMap": {
        "properties": {
          "hall": {
            "$ref": "#/components/schemas/HallOut"
          },
          "screening_id": {
            "title": "Screening Id",
            "type": "integer"
          },
          "seats": {
            "items": {
              "$ref": "#/components/schemas/SeatOut"
            },
            "title": "Seats",
            "type": "array"
          }
        },
        "required": [
          "screening_id",
          "hall",
          "seats"
        ],
        "title": "SeatMap",
        "type": "object"
      },
      "SeatOut": {
        "properties": {
          "grid_col": {
            "title": "Grid Col",
            "type": "integer"
          },
          "grid_row": {
            "title": "Grid Row",
            "type": "integer"
          },
          "is_taken": {
            "title": "Is Taken",
            "type": "boolean"
          },
          "price": {
            "title": "Price",
            "type": "string"
          },
          "row_label": {
            "title": "Row Label",
            "type": "string"
          },
          "seat_id": {
            "title": "Seat Id",
            "type": "integer"
          },
          "seat_number": {
            "title": "Seat Number",
            "type": "integer"
          },
          "seat_type": {
            "title": "Seat Type",
            "type": "string"
          }
        },
        "required": [
          "seat_id",
          "row_label",
          "seat_number",
          "grid_row",
          "grid_col",
          "seat_type",
          "price",
          "is_taken"
        ],
        "title": "SeatOut",
        "type": "object"
      },
      "StaffOut": {
        "properties": {
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "role": {
            "enum": [
              "cashier",
              "manager",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "staff_id": {
            "title": "Staff Id",
            "type": "integer"
          }
        },
        "required": [
          "staff_id",
          "full_name",
          "role"
        ],
        "title": "StaffOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Cinema Ticketing API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bookings": {
      "post": {
        "description": "Hold seats for 10 minutes: a pending booking with one ticket per seat (\u00a76, step 1).",
        "operationId": "hold_seats_api_bookings_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Hold Seats",
        "tags": [
          "bookings"
        ]
      }
    },
    "/api/bookings/{booking_id}": {
      "get": {
        "description": "One of my bookings, with the seconds left on its hold (for the countdown).",
        "operationId": "get_booking_api_bookings__booking_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "booking_id",
            "required": true,
            "schema": {
              "title": "Booking Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Booking",
        "tags": [
          "bookings"
        ]
      }
    },
    "/api/bookings/{booking_id}/cancel": {
      "post": {
        "description": "Cancel my pending hold: the booking becomes 'cancelled' and its seats are free again.\n\nPaid bookings are cancelled (with a refund) by a cashier or manager, not here.",
        "operationId": "cancel_booking_api_bookings__booking_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "booking_id",
            "required": true,
            "schema": {
              "title": "Booking Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Cancel Booking",
        "tags": [
          "bookings"
        ]
      }
    },
    "/api/bookings/{booking_id}/pay": {
      "post": {
        "description": "Fake payment for my pending hold (\u00a76, step 2). A decline is stored; retry is allowed.",
        "operationId": "pay_booking_api_bookings__booking_id__pay_post",
        "parameters": [
          {
            "in": "path",
            "name": "booking_id",
            "required": true,
            "schema": {
              "title": "Booking Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Pay Booking",
        "tags": [
          "bookings"
        ]
      }
    },
    "/api/bookings/{booking_id}/qr.png": {
      "get": {
        "description": "The QR code of my paid booking. One code lets the whole group in.",
        "operationId": "get_booking_qr_api_bookings__booking_id__qr_png_get",
        "parameters": [
          {
            "in": "path",
            "name": "booking_id",
            "required": true,
            "schema": {
              "title": "Booking Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "The QR code as PNG"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Booking Qr",
        "tags": [
          "bookings"
        ]
      }
    },
    "/api/checkin": {
      "post": {
        "description": "Validate a scanned QR code and let the whole booking in (once).",
        "operationId": "check_in_api_checkin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckinIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckinOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Check In",
        "tags": [
          "checkin"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Liveness check used after every deploy.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/me": {
      "get": {
        "description": "Who is logged in, and which profiles they have.",
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "me"
        ]
      }
    },
    "/api/me/customer": {
      "post": {
        "description": "Create the customer profile for the logged-in user. Email comes from the login.",
        "operationId": "create_customer_api_me_customer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerOut"
                }
              }
            },
            "description": "Successful Response"
          },
